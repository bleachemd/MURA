# Cloudflare Pages: правила кэширования.
# Модель распознавания и WASM весят ~19 МБ вместе, поэтому без кэша каждый
# повторный заход тянет их заново. Имена у них не хэшированные, так что срок
# ставим недельный, а не вечный — чтобы обновление модели доехало до людей.

/models/*
  Cache-Control: public, max-age=604800
  X-Content-Type-Options: nosniff

/wasm/*
  Cache-Control: public, max-age=604800
  X-Content-Type-Options: nosniff

# Vite подставляет хэш в имена файлов сборки, поэтому их можно кэшировать навсегда.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Точка входа всегда свежая, иначе новый деплой не доедет до уже открытых вкладок.
/index.html
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
